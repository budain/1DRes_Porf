# -------------------------- 模型训练与评估 --------------------------
def train_model(model: nn.Module, train_loader: DataLoader, val_loader: DataLoader,
                criterion: nn.Module, optimizer: torch.optim.Optimizer,
                scheduler: torch.optim.lr_scheduler._LRScheduler,
                use_phys: bool = False, patience: int = 150, max_epochs: int = 1200) -> nn.Module:

    best_val_loss = float('inf')
    counter = 0

    for epoch in range(max_epochs):
        model.train()
        for batch in train_loader:
            if use_phys:
                bx, rt, d, phi_i, by = [b.to(device) for b in batch]
                pred = model(bx, rt, d, phi_i)
            else:
                bx, by = batch[0].to(device), batch[-1].to(device)
                pred = model(bx)

            optimizer.zero_grad()
            loss = criterion(pred, by)
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
            optimizer.step()

        model.eval()
        val_loss = 0
        with torch.no_grad():
            for batch in val_loader:
                if use_phys:
                    bx, rt, d, phi_i, by = [b.to(device) for b in batch]
                    pred = model(bx, rt, d, phi_i)
                else:
                    bx, by = batch[0].to(device), batch[-1].to(device)
                    pred = model(bx)

                val_loss += criterion(pred, by).item()

        val_loss /= len(val_loader)
        scheduler.step(val_loss)

        if epoch % 50 == 0:
            print(f'Epoch {epoch}: Val Loss = {val_loss:.6f}')

        if val_loss < best_val_loss:
            best_val_loss = val_loss
            torch.save(model.state_dict(), 'best_resnet1d_porf.pth')
            counter = 0
        else:
            counter += 1

        if counter >= patience:
            print("早停触发")
            break

    return model


def evaluate_model(model: nn.Module, test_loader: DataLoader,
                   scY: StandardScaler, y_test_original: np.ndarray,
                   test_depth: np.ndarray, use_phys: bool = False) -> Tuple[np.ndarray, pd.DataFrame]:

    model.eval()
    preds_scaled = []

    with torch.no_grad():
        for batch in test_loader:
            if use_phys:
                bx, rt, d, phi_i, _ = [b.to(device) for b in batch]
                pred = model(bx, rt, d, phi_i).cpu().numpy()
            else:
                bx = batch[0].to(device)
                _ = batch[-1]
                pred = model(bx).cpu().numpy()
            preds_scaled.extend(pred)

    preds_scaled = np.array(preds_scaled)
    preds = scY.inverse_transform(preds_scaled.reshape(-1, 1)).ravel()

    results = pd.DataFrame({
        'DEPTH': test_depth,
        'True_PMT': y_test_original,
        'Predicted_PMT': preds
    })

    return preds, results


