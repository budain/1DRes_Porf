# -------------------------- GGA 地质物理信息约束注意力 --------------------------
class PhysicalConstraintBuilder(nn.Module):
    """构建物理先验约束矩阵 P_archie, P_density, P_geo"""

    def __init__(self, rho_ma: float = 2.68, rho_f: float = 1.0,
                 a: float = 0.62, m: float = 2.15, n: float = 2.0):
        super().__init__()
        self.rho_ma = rho_ma
        self.rho_f = rho_f
        self.a = a
        self.m = m
        self.n = n
        # 可学习的束平衡系数 α, β (α+β=1 via softmax)
        self.alpha_logits = nn.Parameter(torch.tensor([0.0, 0.0]))

    def forward(self, rt: torch.Tensor, den: torch.Tensor, phi: torch.Tensor,
                sw: torch.Tensor = None) -> torch.Tensor:
        """
        Args:
            rt: 电阻率 (B, L)
            den: 密度 (B, L)
            phi: 当前孔隙度估计 (B, L), 初始迭代用 PHI_DEN
            sw: 含水饱和度 (B, L), 可选
        Returns:
            P_geo: 复合物理约束矩阵 (B, L, L)
        """
        B, L = rt.shape
        device = rt.device

        # 计算电阻率和密度的全局标准差 (用于归一化)
        sigma_rt = torch.std(rt, dim=1, keepdim=True).clamp(min=0.1)  # (B, 1)
        sigma_den = torch.std(den, dim=1, keepdim=True).clamp(min=0.01)  # (B, 1)

        # --- P_archie: 阿尔奇约束矩阵 ---
        # F_pred = a * φ^(-m) * S_w^(-n)
        phi_clamped = phi.clamp(min=0.001, max=0.4)
        if sw is None:
            sw = torch.ones_like(phi)
        sw_clamped = sw.clamp(min=0.01, max=1.0)
        F_pred = self.a * (phi_clamped ** (-self.m)) * (sw_clamped ** (-self.n))  # (B, L)
        # P_archie(i,j) = exp(-|RT_i - F_pred(j)| / σ_RT)
        rt_expanded = rt.unsqueeze(2)  # (B, L, 1)
        F_expanded = F_pred.unsqueeze(1)  # (B, 1, L)
        P_archie = torch.exp(-torch.abs(rt_expanded - F_expanded)
                             / sigma_rt.unsqueeze(2))  # (B, L, L)

        # --- P_density: 密度体积模型约束矩阵 ---
        # ρ_pred = φ·ρ_f + (1-φ)·ρ_ma
        rho_pred = phi * self.rho_f + (1.0 - phi) * self.rho_ma  # (B, L)
        den_expanded = den.unsqueeze(2)  # (B, L, 1)
        rho_expanded = rho_pred.unsqueeze(1)  # (B, 1, L)
        P_density = torch.exp(-torch.abs(den_expanded - rho_expanded)
                              / sigma_den.unsqueeze(2))  # (B, L, L)

        # --- 可学习融合: P_geo = α·P_archie + β·P_density ---
        alpha_beta = torch.softmax(self.alpha_logits, dim=0)  # (2,)
        alpha, beta = alpha_beta[0], alpha_beta[1]
        P_geo = alpha * P_archie + beta * P_density  # (B, L, L)

        return P_geo


class GGAHead(nn.Module):
    """单头物理嵌入缩放点积注意力"""

    def __init__(self, d_model: int = 64, d_k: int = 64, gamma: float = 0.3):
        super().__init__()
        self.d_k = d_k
        self.gamma = gamma
        self.W_q = nn.Linear(d_model, d_k)
        self.W_k = nn.Linear(d_model, d_k)
        self.W_v = nn.Linear(d_model, d_k)

    def forward(self, x: torch.Tensor, P_geo: torch.Tensor,
                mask: torch.Tensor = None) -> torch.Tensor:
        """
        Args:
            x: 特征序列 (B, L, d_model)
            P_geo: 物理约束矩阵 (B, L, L)
            mask: 可选注意力掩码 (B, L, L) 用于限制窗口
        Returns:
            加权特征 (B, L, d_k)
        """
        Q = self.W_q(x)  # (B, L, d_k)
        K = self.W_k(x)  # (B, L, d_k)
        V = self.W_v(x)  # (B, L, d_k)

        # 缩放点积 + 物理约束
        scores = torch.matmul(Q, K.transpose(-2, -1)) / (self.d_k ** 0.5)  # (B, L, L)
        scores = scores + self.gamma * P_geo  # 物理约束嵌入

        if mask is not None:
            scores = scores.masked_fill(mask == 0, float('-inf'))

        attn_weights = torch.softmax(scores, dim=-1)  # (B, L, L)
        out = torch.matmul(attn_weights, V)  # (B, L, d_k)
        return out


class DualHeadGating(nn.Module):
    """双头门控融合: 突变头(短窗口+ΔP_geo) + 趋势头(长窗口+P_geo), 可学习门控融合"""

    def __init__(self, d_model: int = 64, gamma: float = 0.3,
                 short_window: int = 2, long_window: int = 9):
        super().__init__()
        self.short_window = short_window
        self.long_window = long_window

        self.mutation_head = GGAHead(d_model, d_model, gamma)
        self.trend_head = GGAHead(d_model, d_model, gamma)
        self.gate = nn.Sequential(
            nn.Linear(d_model * 2, d_model),
            nn.Sigmoid()
        )

    def _window_mask(self, L: int, window: int, device: torch.device) -> torch.Tensor:
        idx = torch.arange(L, device=device)
        dist = torch.abs(idx.unsqueeze(1) - idx.unsqueeze(0))
        return (dist <= window).float()

    def forward(self, x: torch.Tensor, P_geo: torch.Tensor) -> torch.Tensor:
        L = x.shape[1]
        device = x.device

        # 突变头: 短窗口 + ΔP_geo (放大物理突变处的约束)
        short_mask = self._window_mask(L, self.short_window, device)
        delta_P = torch.abs(P_geo - P_geo.transpose(-2, -1))
        P_mutation = P_geo * (1.0 + delta_P)
        h1 = self.mutation_head(x, P_mutation, mask=short_mask.unsqueeze(0))

        # 趋势头: 长窗口 + P_geo (保持原始物理约束)
        long_mask = self._window_mask(L, self.long_window, device)
        h2 = self.trend_head(x, P_geo, mask=long_mask.unsqueeze(0))

        # 门控融合: g = σ(W_g·[h1;h2] + b_g) ∈ (B, L, D)
        h_cat = torch.cat([h1, h2], dim=-1)
        g = self.gate(h_cat)
        return g * h1 + (1.0 - g) * h2


class ResNetGGA_BiLSTM(nn.Module):
    """ResNet特征提取 → GGA双头门控注意力 → FC

    Parameters
    ----------
    num_channels : int
        输入测井曲线数量
    dropout_rate : float
    use_multiscale : bool
        True = Inception多尺度残差块, False = 标准残差块
    num_blocks : int
        残差块数量 (2 或 3)
    rho_ma, rho_f, a, m, n : float
        物理约束参数
    """

    def __init__(self, num_channels: int, dropout_rate: float = 0.4,
                 use_multiscale: bool = True, num_blocks: int = 2,
                 use_gga: bool = True,
                 rho_ma: float = 2.68, rho_f: float = 1.0,
                 a: float = 0.62, m: float = 2.15, n: float = 2.0):
        super().__init__()
        self.use_gga = use_gga
        self.feature_extractor = ResNetFeatureExtractor(
            num_channels, dropout_rate,
            use_multiscale=use_multiscale, num_blocks=num_blocks
        )
        if use_gga:
            self.constraint_builder = PhysicalConstraintBuilder(rho_ma, rho_f, a, m, n)
            self.gga = DualHeadGating(d_model=32, gamma=0.3, short_window=3, long_window=30)
        self.fc = nn.Sequential(
            nn.Linear(32, 16),
            nn.ReLU(),
            nn.Dropout(dropout_rate),
            nn.Linear(16, 1)
        )

    def forward(self, x, rt_raw=None, den_raw=None, phi_init=None):
        x = self.feature_extractor(x)       # (B, 32, L)
        x = x.permute(0, 2, 1)              # (B, L, 32)

        if self.use_gga and rt_raw is not None and den_raw is not None and phi_init is not None:
            P_geo = self.constraint_builder(rt_raw, den_raw, phi_init)
            x = self.gga(x, P_geo)          # (B, L, 32)

        x = x.mean(dim=1)                   # (B, 32)
        out = self.fc(x)
        return out.squeeze(1)


# -------------------------- 数据加载与处理 --------------------------
def load_and_process_las(file_path: str) -> pd.DataFrame | None:
    """加载LAS文件（支持标准LAS和空格分隔纯数据格式），标准化深度列"""
    try:
        # 先尝试标准LAS格式
        try:
            las = lasio.read(file_path)
            df = las.df().reset_index()
        except Exception:
            # 非标准格式：空格分隔纯数据，首行 # 注释为列名
            with open(file_path, 'r') as f:
                lines = f.readlines()
            # 找列名行（以 # 开头的注释行）
            header_line = None
            for line in lines:
                stripped = line.strip()
                if stripped.startswith('#'):
                    header_line = stripped.lstrip('#').strip()
                    break
            if header_line is None:
                # 无注释头，用第一行数据推断
                data_lines = [l for l in lines if l.strip() and not l.strip().startswith('#')]
                if not data_lines:
                    raise ValueError("空文件")
                # 假设列顺序
                df = pd.read_csv(file_path, delim_whitespace=True, comment='#', header=None)
                df.columns = [f'COL_{i}' for i in range(df.shape[1])]
            else:
                cols = header_line.split()
                df = pd.read_csv(file_path, delim_whitespace=True, comment='#', header=None, names=cols)

        # 标准化深度列
        possible_depth = ['DEPTH', 'DEPT', 'MD', 'TVD', 'DEPH', 'Depth', 'depth']
        depth_col = None
        for col in df.columns:
            if col.upper() in [p.upper() for p in possible_depth]:
                depth_col = col
                break
        if depth_col is None:
            depth_col = df.columns[0]
        df = df.rename(columns={depth_col: 'DEPTH'})

        # 所有列名大写
        df.columns = df.columns.str.upper()

        # 坏值 → NaN（放在merge之前，让CNL_MATH能填补CNL的坏值）
        df = df.replace([-999.25, -9999, -9999.0, -99999, -99999.0], np.nan)

        # 同义列合并: 若两列共存，用非空值补齐主列；若只有别名，重命名
        merge_pairs = [
            ('CAL', 'CAL1'), ('CAL', 'CALI'),
            ('CNL', 'CNL_MATH'),
            ('AC', 'AC_MATH'),
        ]
        for primary, alias_name in merge_pairs:
            if primary in df.columns and alias_name in df.columns:
                df[primary] = df[primary].fillna(df[alias_name])
                df = df.drop(columns=[alias_name])
            elif alias_name in df.columns and primary not in df.columns:
                df = df.rename(columns={alias_name: primary})

        # 简单别名 (只重命名，目标列不存在时才映射)
        simple_alias = {
            'RT': 'RLLD',
            'RD': 'RLLD', 'HLLD': 'RLLD',
            'RS': 'RLLS', 'HLLS': 'RLLS',
            'DT24': 'AC',
            'CNC': 'CNL',
            'ZDEN': 'DEN',
        }
        df = df.rename(columns={k: v for k, v in simple_alias.items()
                                if k in df.columns and v not in df.columns})

        # 输入曲线（不含目标PMT）
        required = ['AC', 'CAL', 'CNL', 'DEN', 'GR', 'RLLD', 'RLLS', 'SP']
        available = [c for c in required if c in df.columns]

        if 'PMT' not in df.columns:
            if 'MPHITA' in df.columns:
                df = df.rename(columns={'MPHITA': 'PMT'})
            else:
                print(f"{file_path} 无 PMT/MPHITA 目标列，跳过")
                return None

        df = df[['DEPTH'] + available + ['PMT']]

        # 范围裁切: 超出合理范围的值 → NaN (后续插值补齐)
        for c in df.columns:
            if c == 'DEPTH':
                continue
            df.loc[(df[c] < -1000) | (df[c] > 10000), c] = np.nan

        # 按深度排序后, 每列独立线性插值 (测井标准做法)
        df = df.sort_values('DEPTH')
        curve_cols = [c for c in df.columns if c != 'DEPTH' and c != 'PMT']
        for c in curve_cols:
            df[c] = df[c].interpolate(method='linear', limit_direction='both')

        # 计算泥质含量 Vsh: GR直方图两端频数≥2%的位置作为砂/泥基线
        if 'GR' in df.columns:
            gr_full = df['GR'].dropna()
            if len(gr_full) > 100:
                hist, bins = np.histogram(gr_full.values, bins=50)
                centers = (bins[:-1] + bins[1:]) / 2
                threshold = len(gr_full) * 0.02
                gr_clean = centers[np.argmax(hist >= threshold)]
                gr_shale = centers[len(hist) - 1 - np.argmax(hist[::-1] >= threshold)]
                if gr_shale > gr_clean:
                    df['VSH'] = ((df['GR'] - gr_clean) / (gr_shale - gr_clean)).clip(0, 1)
                else:
                    df['VSH'] = 0.0
            else:
                df['VSH'] = 0.0

        # 剔除整列为NaN的曲线 (测井未采集, 插值无法挽救) → 直接跳过该井
        all_nan_cols = [c for c in available if df[c].isna().all()]
        if all_nan_cols:
            print(f"  [跳过] {os.path.basename(file_path)}: 曲线整列为空 {all_nan_cols}")
            return None

        # 仅对目标列 PMT 做 dropna (PMT 不能插值, 是标签)
        df = df.dropna(subset=['PMT'])

        if df.empty:
            print(f"警告: {file_path} 处理后为空")
            return None
        return df

    except Exception as e:
        print(f"处理 {file_path} 出错: {e}")
        return None


def prepare_features(df: pd.DataFrame) -> list:
    """返回可用基础测井曲线列表（GGA物理约束替代手工衍生特征）"""
    base_features = ['AC', 'CAL', 'CNL', 'DEN', 'GR', 'RLLD', 'RLLS', 'SP']
    return [f for f in base_features if f in df.columns]


def discover_wells(data_dir: str):
    """扫描数据目录中所有 .las 文件，返回排序后的文件名列表"""
    if not os.path.isdir(data_dir):
        raise FileNotFoundError(f"数据目录不存在: {data_dir}")
    pattern = os.path.join(data_dir, '*.las')
    las_files = sorted(glob.glob(pattern))
    if not las_files:
        raise FileNotFoundError(f"数据目录中未找到 .las 文件: {data_dir}")
    return [os.path.basename(f) for f in las_files]


def split_wells(well_list, train_ratio=0.70, val_ratio=0.15, test_ratio=0.15,
                n_test_wells=None, test_well_names=None, random_seed=42):
    """将井名列表按井级划分为 train / val / test

    Parameters
    ----------
    n_test_wells : int or None
        若为整数，则随机预留恰好该数量的井做测试，其余井按比例分给训练/验证。
        若为 None，则全部按 ratio 划分。
    test_well_names : str or list or None
        指定具体井名做测试（如 'Sa10' 或 ['Sa10', 'Sa102']）。
        优先级高于 n_test_wells。指定的井必须在 well_list 中。
    """
    import random as _random
    rng = _random.Random(random_seed)
    wells = list(well_list)

    # --- 优先处理: 用户指定测试井名 ---
    if test_well_names is not None:
        if isinstance(test_well_names, str):
            test_well_names = [test_well_names]
        unknown = set(test_well_names) - set(wells)
        if unknown:
            raise ValueError(f"指定的测试井不在合格列表中: {unknown}")
        # 确保测试井按 wells 原始顺序 (便于复现)
        test_wells = [w for w in wells if w in set(test_well_names)]
        remaining = [w for w in wells if w not in set(test_well_names)]
        rng.shuffle(remaining)
        n_rem = len(remaining)
        n_train = max(1, int(n_rem * train_ratio / (train_ratio + val_ratio)))
        train_wells = remaining[:n_train]
        val_wells = remaining[n_train:]
        return train_wells, val_wells, test_wells

    # --- n_test_wells: 随机预留 N 口 ---
    rng.shuffle(wells)

    n_total = len(wells)

    if n_test_wells is not None:
        if n_test_wells >= n_total:
            raise ValueError(f"n_test_wells ({n_test_wells}) 必须 < 总井数 ({n_total})")
        test_wells = wells[:n_test_wells]
        remaining = wells[n_test_wells:]
        n_rem = len(remaining)
        n_train = max(1, int(n_rem * train_ratio / (train_ratio + val_ratio)))
        train_wells = remaining[:n_train]
        val_wells = remaining[n_train:]
    else:
        n_train = max(1, int(n_total * train_ratio))
        n_val = max(1, int(n_total * val_ratio))
        n_test = max(1, n_total - n_train - n_val)
        train_wells = wells[:n_train]
        val_wells = wells[n_train:n_train + n_val]
        test_wells = wells[n_train + n_val:]

    if not train_wells or not val_wells or not test_wells:
        raise ValueError(
            f"划分产生空集: train={len(train_wells)}, val={len(val_wells)}, "
            f"test={len(test_wells)}。请调整比例或增加井数。"
        )

    return train_wells, val_wells, test_wells


