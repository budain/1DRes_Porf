# -------------------------- 数据集类 --------------------------
class WellLogDataset(Dataset):
    """测井序列数据集类（用于1D ResNet + GGA）"""

    def __init__(self, features: np.ndarray, targets: np.ndarray,
                 phys_data: dict = None):
        """phys_data: {'rt_raw': (N,), 'den_raw': (N,), 'phi_init': (N,)} 或 None"""
        self.features = torch.from_numpy(features).float()
        self.targets = torch.from_numpy(targets).float()
        self.has_phys = phys_data is not None
        if phys_data is not None:
            self.rt_raw = torch.from_numpy(phys_data['rt_raw']).float()
            self.den_raw = torch.from_numpy(phys_data['den_raw']).float()
            self.phi_init = torch.from_numpy(phys_data['phi_init']).float()

    def __len__(self) -> int:
        return len(self.features)

    def __getitem__(self, idx: int) -> Tuple:
        if self.has_phys:
            return (self.features[idx],
                    self.rt_raw[idx], self.den_raw[idx], self.phi_init[idx],
                    self.targets[idx])
        return self.features[idx], self.targets[idx]


# -------------------------- 1D ResNet 模型 --------------------------
class ResidualBlock1D(nn.Module):
    """标准残差块 (kernel=3, 两层卷积), 保留向后兼容"""
    def __init__(self, in_channels: int, out_channels: int, dropout_rate: float = 0.3):
        super().__init__()
        self.conv1 = nn.Conv1d(in_channels, out_channels, kernel_size=3, padding=1, bias=False)
        self.bn1 = nn.BatchNorm1d(out_channels)
        self.conv2 = nn.Conv1d(out_channels, out_channels, kernel_size=3, padding=1, bias=False)
        self.bn2 = nn.BatchNorm1d(out_channels)
        self.relu = nn.ReLU(inplace=True)
        self.dropout = nn.Dropout(dropout_rate)

        self.shortcut = nn.Sequential()
        if in_channels != out_channels:
            self.shortcut = nn.Sequential(
                nn.Conv1d(in_channels, out_channels, kernel_size=1, bias=False),
                nn.BatchNorm1d(out_channels)
            )

    def forward(self, x):
        residual = self.shortcut(x)
        out = self.conv1(x)
        out = self.bn1(out)
        out = self.relu(out)
        out = self.dropout(out)
        out = self.conv2(out)
        out = self.bn2(out)
        out += residual
        out = self.relu(out)
        return out


class MultiScaleResidualBlock1D(nn.Module):
    """多尺度残差块: N路并行分支 → 拼接 → 1×1融合 + 残差连接

    Parameters
    ----------
    kernel_sizes : list[int]
        各分支的卷积核大小, 默认 [3, 5, 7].
        如 [5, 7, 11] 用大核抓宽特征, [3] 退化为单路标准残差.
    """
    def __init__(self, in_channels: int, out_channels: int, dropout_rate: float = 0.3,
                 kernel_sizes: list = None):
        super().__init__()
        if kernel_sizes is None:
            kernel_sizes = [3, 5, 7]
        self.kernel_sizes = kernel_sizes
        n_branches = len(kernel_sizes)

        # 通道均分 (最后一路补齐余数)
        base = out_channels // n_branches
        ch_list = [base] * (n_branches - 1) + [out_channels - base * (n_branches - 1)]

        self.branches = nn.ModuleList()
        for k, ch in zip(kernel_sizes, ch_list):
            self.branches.append(nn.Sequential(
                nn.Conv1d(in_channels, ch, kernel_size=k, padding=k // 2, bias=False),
                nn.BatchNorm1d(ch),
                nn.ReLU(inplace=True),
            ))

        # 1×1 跨尺度融合
        self.fuse = nn.Sequential(
            nn.Conv1d(out_channels, out_channels, kernel_size=1, bias=False),
            nn.BatchNorm1d(out_channels),
        )

        self.relu = nn.ReLU(inplace=True)
        self.dropout = nn.Dropout(dropout_rate)

        # Shortcut: 1×1 conv 匹配通道
        self.shortcut = nn.Sequential()
        if in_channels != out_channels:
            self.shortcut = nn.Sequential(
                nn.Conv1d(in_channels, out_channels, kernel_size=1, bias=False),
                nn.BatchNorm1d(out_channels)
            )

    def forward(self, x):
        residual = self.shortcut(x)
        branch_outs = [branch(x) for branch in self.branches]
        out = torch.cat(branch_outs, dim=1)  # (B, out_channels, L)
        out = self.fuse(out)
        out = self.dropout(out)
        out += residual
        out = self.relu(out)
        return out


class CurveDepthInception(nn.Module):
    """2D Inception 初始层: 跨曲线×深度联合卷积

    将 (num_curves, depth) 当作2D网格, 四路并行分支的卷积核覆盖全部曲线
    和不同深度窗口, 一次性学习"哪些曲线在相邻深度上有联合响应模式".

    核尺寸:
      - (C, 1): 当前深度点, 8条曲线间的瞬时关系 (点状特征)
      - (C, 3): ±1 深度邻域, 捕捉薄层级的曲线组合变化
      - (C, 5): ±2 深度邻域, 捕捉岩性过渡带
      - (C, 7): ±3 深度邻域, 捕捉沉积旋回级曲线协变

    Parameters
    ----------
    num_curves : int
        输入曲线数 (如 8)
    out_channels : int
        输出通道数, 四分支均分
    """
    def __init__(self, num_curves: int, out_channels: int = 32, dropout_rate: float = 0.4):
        super().__init__()
        # 四分支均分通道
        c1 = out_channels // 4
        c3 = out_channels // 4
        c5 = out_channels // 4
        c7 = out_channels - c1 - c3 - c5  # 确保总和 = out_channels
        self.num_curves = num_curves

        # 分支1: kernel (C, 1) — 只看当前深度点
        self.branch1 = nn.Sequential(
            nn.Conv2d(1, c1, kernel_size=(num_curves, 1), stride=1, padding=0, bias=False),
            nn.BatchNorm2d(c1),
            nn.ReLU(inplace=True),
        )
        # 分支3: kernel (C, 3) — ±1 深度邻域
        self.branch3 = nn.Sequential(
            nn.Conv2d(1, c3, kernel_size=(num_curves, 3), stride=1,
                      padding=(0, 1), bias=False),
            nn.BatchNorm2d(c3),
            nn.ReLU(inplace=True),
        )
        # 分支5: kernel (C, 5) — ±2 深度邻域
        self.branch5 = nn.Sequential(
            nn.Conv2d(1, c5, kernel_size=(num_curves, 5), stride=1,
                      padding=(0, 2), bias=False),
            nn.BatchNorm2d(c5),
            nn.ReLU(inplace=True),
        )
        # 分支7: kernel (C, 7) — ±3 深度邻域
        self.branch7 = nn.Sequential(
            nn.Conv2d(1, c7, kernel_size=(num_curves, 7), stride=1,
                      padding=(0, 3), bias=False),
            nn.BatchNorm2d(c7),
            nn.ReLU(inplace=True),
        )

        # 1×1 跨尺度融合 + 降维
        self.fuse = nn.Sequential(
            nn.Conv1d(out_channels, out_channels, kernel_size=1, bias=False),
            nn.BatchNorm1d(out_channels),
            nn.ReLU(inplace=True),
            nn.Dropout(dropout_rate),
        )

    def forward(self, x):
        # x: (B, C, L) → 2D: (B, 1, C, L)
        x_2d = x.unsqueeze(1)

        h1 = self.branch1(x_2d)   # (B, c1, 1, L)
        h3 = self.branch3(x_2d)   # (B, c3, 1, L)
        h5 = self.branch5(x_2d)   # (B, c5, 1, L)
        h7 = self.branch7(x_2d)   # (B, c7, 1, L)

        # 拼接 → (B, out_channels, 1, L) → squeeze曲线维 → (B, out_channels, L)
        out = torch.cat([h1, h3, h5, h7], dim=1).squeeze(2)
        out = self.fuse(out)
        return out


class ResNetFeatureExtractor(nn.Module):
    """ResNet特征提取器

    Parameters
    ----------
    num_channels : int
        输入通道数 (测井曲线数量, 默认7)
    dropout_rate : float
        Dropout比例
    use_multiscale : bool
        True = Inception模式 (2D曲线深度初始层 + 1D多尺度残差块)
        False = 标准模式 (Conv1d初始层 + 标准残差块, 向后兼容)
    num_blocks : int
        残差块数量: 2 (原版) 或 3 (更深). 通道序列自动适配.
    """
    def __init__(self, num_channels: int, dropout_rate: float = 0.4,
                 use_multiscale: bool = True, num_blocks: int = 2):
        super().__init__()
        self.use_multiscale = use_multiscale

        if use_multiscale:
            # 2D Inception: kernel = (num_curves, 1/3/5/7) 同时跨曲线和深度
            self.initial = CurveDepthInception(num_channels, out_channels=32,
                                                dropout_rate=dropout_rate)
        else:
            # 原版1D初始层 (向后兼容)
            self.initial = nn.Sequential(
                nn.Conv1d(num_channels, 32, kernel_size=7, padding=3, bias=False),
                nn.BatchNorm1d(32),
                nn.ReLU(inplace=True),
                nn.Dropout(dropout_rate)
            )

        BlockCls = MultiScaleResidualBlock1D if use_multiscale else ResidualBlock1D

        # 非对称核配置: 低层大核抓形态, 高层小核精调
        if num_blocks == 2:
            ch_seq = [(32, 64), (64, 32)]
            kernel_cfgs = [[5, 7, 11], [3]]
        elif num_blocks == 3:
            ch_seq = [(32, 64), (64, 64), (64, 32)]
            kernel_cfgs = [[7, 11, 15], [5, 7, 9], [3, 5]]   # 大窗口用大核
        else:
            raise ValueError(f'num_blocks must be 2 or 3, got {num_blocks}')

        self.blocks = nn.Sequential(*[
            BlockCls(in_ch, out_ch, dropout_rate, kernel_sizes=kc)
            for (in_ch, out_ch), kc in zip(ch_seq, kernel_cfgs)
        ])
        self.out_channels = ch_seq[-1][1]  # 32

    def forward(self, x):
        x = self.initial(x)
        x = self.blocks(x)  # (B, out_channels, L)
        return x

