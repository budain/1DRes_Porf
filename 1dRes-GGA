    # 通用单井原始数据加载 (不做标准化, 不做滑动窗口)
    def load_well_raw(well_file, sel_feat):
        full_path = os.path.join(data_path, well_file)
        df = load_and_process_las(full_path)
        if df is None:
            return None
        df = df.sort_values('DEPTH').reset_index(drop=True)
        missing = set(sel_feat) - set(df.columns)
        if missing:
            print(f"  {well_file} 缺少 {missing}，跳过")
            return None
        df = df[['DEPTH', 'PMT'] + sel_feat]
        df = df[(df['PMT'] >= 0) & (df['PMT'] <= 45)]

        rt_col = df['RLLD'].values.copy() if 'RLLD' in df.columns else np.full(len(df), 20.0)
        den_col = df['DEN'].values.copy() if 'DEN' in df.columns else np.full(len(df), 2.5)

        return {'X_raw': df[sel_feat].values.astype(np.float32),
                'y_raw': df['PMT'].values.astype(np.float32),
                'rt_raw': rt_col.astype(np.float32),
                'den_raw': den_col.astype(np.float32),
                'depth': df['DEPTH'].values.astype(np.float32)}

    def make_windows(X_raw, y_raw, rt_raw, den_raw, scX, scY, half_win, win_size):
        """全局标准化 + 滑动窗口"""
        X_n = scX.transform(X_raw)
        y_n = scY.transform(y_raw.reshape(-1, 1)).ravel()
        phi_raw = (RHO_MA - den_raw) / (RHO_MA - RHO_F)

        X_p = np.pad(X_n, ((half_win, half_win), (0, 0)), mode='reflect')
        rt_p = np.pad(rt_raw, (half_win, half_win), mode='reflect')
        dn_p = np.pad(den_raw, (half_win, half_win), mode='reflect')
        ph_p = np.pad(phi_raw, (half_win, half_win), mode='reflect')

        n = len(y_raw)
        n_curves = X_raw.shape[1]
        # 每条曲线拆成3通道: 原始值 + 一阶梯度(形态) + 二阶梯度(曲率)
        n_feat = n_curves * 3
        X_s = np.zeros((n, n_feat, win_size), dtype=np.float32)
        rt_s = np.zeros((n, win_size), dtype=np.float32)
        dn_s = np.zeros((n, win_size), dtype=np.float32)
        ph_s = np.zeros((n, win_size), dtype=np.float32)
        for i in range(n):
            for j in range(n_curves):
                w = X_p[i:i + win_size, j]           # 第j条曲线的61点窗口
                X_s[i, j*3, :]   = w                 # 原始值
                X_s[i, j*3+1, :] = np.gradient(w)    # 一阶: 上升/下降形态
                X_s[i, j*3+2, :] = np.gradient(np.gradient(w))  # 二阶: 钟形/漏斗形
            rt_s[i] = rt_p[i:i + win_size]
            dn_s[i] = dn_p[i:i + win_size]
            ph_s[i] = ph_p[i:i + win_size]

        return X_s, y_n, rt_s, dn_s, ph_s

    # =================== 步骤1: 加载所有井原始数据 ===================
    raw_data = {}
    for w in qualified:
        d = load_well_raw(w, selected_features)
        if d is not None:
            raw_data[w] = d

    # =================== 步骤2: 在训练井上拟合全局标准化 ===================
    X_train_raw = np.concatenate([raw_data[w]['X_raw'] for w in train_wells], axis=0)
    y_train_raw = np.concatenate([raw_data[w]['y_raw'] for w in train_wells], axis=0)

    scX = StandardScaler().fit(X_train_raw)
    scY = StandardScaler().fit(y_train_raw.reshape(-1, 1))
    print(f"\n全局标准化: X mean={scX.mean_[:3]}...  std={scX.scale_[:3]}...")
    print(f"              y mean={scY.mean_[0]:.3f}  std={scY.scale_[0]:.3f}")

    # =================== 步骤3: 标准化 + 滑动窗口 ===================
    def process_split(well_list, split_name):
        all_X, all_y, all_rt, all_den, all_phi, all_depth, all_y_orig = [], [], [], [], [], [], []
        for w in well_list:
            r = raw_data[w]
            X_s, y_n, rt_s, dn_s, ph_s = make_windows(
                r['X_raw'], r['y_raw'], r['rt_raw'], r['den_raw'],
                scX, scY, half_window, window_size)
            all_X.append(X_s)
            all_y.append(y_n)
            all_rt.append(rt_s)
            all_den.append(dn_s)
            all_phi.append(ph_s)
            all_depth.append(r['depth'])
            all_y_orig.append(r['y_raw'])
        return (np.concatenate(all_X), np.concatenate(all_y),
                np.concatenate(all_rt), np.concatenate(all_den),
                np.concatenate(all_phi), np.concatenate(all_depth),
                np.concatenate(all_y_orig))

    X_train_all, y_train_all, rt_train_all, den_train_all, phi_train_all, _, _ = \
        process_split(train_wells, 'train')
