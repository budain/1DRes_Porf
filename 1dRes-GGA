    # hp_dropout, hp_lr, hp_batch = best_dropout, best_lr, best_batch

    print(f"\n使用默认超参数: dropout={hp_dropout}, lr={hp_lr}, batch_size={hp_batch}")

    # 数据加载器（井级划分: train/val/test 各自独立井）
    train_phys = {'rt_raw': rt_train_all, 'den_raw': den_train_all, 'phi_init': phi_train_all}
    val_phys = {'rt_raw': rt_val_all, 'den_raw': den_val_all, 'phi_init': phi_val_all}
    test_phys = {'rt_raw': rt_test_all, 'den_raw': den_test_all, 'phi_init': phi_test_all}

    phys_train = train_phys if use_gga else None
    phys_val = val_phys if use_gga else None
    phys_test = test_phys if use_gga else None
    train_dataset = WellLogDataset(X_train_all, y_train_all, phys_train)
    val_dataset = WellLogDataset(X_val_all, y_val_all, phys_val)
    test_dataset = WellLogDataset(X_test_all, np.zeros(len(y_test_original_all)), phys_test)

    train_loader = DataLoader(train_dataset, batch_size=hp_batch, shuffle=True)
    val_loader = DataLoader(val_dataset, batch_size=hp_batch, shuffle=False)
    test_loader = DataLoader(test_dataset, batch_size=hp_batch, shuffle=False)

    # 初始化模型 (Inception多尺度残差块)
    model = ResNetGGA_BiLSTM(num_channels=num_channels, dropout_rate=hp_dropout,
                             use_multiscale=True, num_blocks=3,
                             use_gga=use_gga).to(device)
    criterion = nn.MSELoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=hp_lr, weight_decay=1e-4)
    scheduler = ReduceLROnPlateau(optimizer, mode='min', factor=0.5, patience=10)

    # 训练（ResNet → GGA → FC）
    model = train_model(model, train_loader, val_loader, criterion, optimizer, scheduler,
                        use_phys=use_gga, patience=150, max_epochs=1200)

    # 加载最佳模型并评估
    model.load_state_dict(torch.load('best_resnet1d_porf.pth'))
    preds, results = evaluate_model(model, test_loader, scY, y_test_original_all,
                                    test_depth_all, use_phys=use_gga)

    # 保存结果
    results.to_excel('PMT_Prediction_Results_1DResNet.xlsx', index=False)
    print("\n预测结果已保存至 PMT_Prediction_Results_1DResNet.xlsx")

    # 评估指标
    mse = mean_squared_error(y_test_original_all, preds)
    mae = mean_absolute_error(y_test_original_all, preds)
    r2 = r2_score(y_test_original_all, preds)

    test_names = ', '.join(test_wells)
    print(f"\n测试集评估 ({test_names}):")
    print(f"  MSE = {mse:.6f}")
    print(f"  MAE = {mae:.6f}")
    print(f"  R²  = {r2:.6f}")


